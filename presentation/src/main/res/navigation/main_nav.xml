<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.home.HomeFragment"
        android:label="HomeFragment">
        <action
            android:id="@+id/action_homeFragment_to_createPartyFragment"
            app:destination="@id/createPartyFragment" />
        <action
            android:id="@+id/action_homeFragment_to_showPartyFragment"
            app:destination="@id/showPartyFragment" />
        <action
            android:id="@+id/action_homeFragment_to_matchDetailFragment"
            app:destination="@id/matchDetailFragment" />
        <action
            android:id="@+id/action_homeFragment_to_notificationFragment"
            app:destination="@id/notificationFragment" />
        <action
            android:id="@+id/action_homeFragment_to_showPartySearchFragment"
            app:destination="@id/showPartySearchFragment" />

    </fragment>

    <fragment
        android:id="@+id/departureMapFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.createparty.departure.DepartureMapFragment"
        android:label="MapFragment">
        <action
            android:id="@+id/action_departureMapFragment_to_departureSearchFragment"
            app:destination="@id/departureSearchFragment" />
    </fragment>


    <fragment
        android:id="@+id/createPartyFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.createparty.CreatePartyFragment"
        android:label="CreatePartyFragment">
        <action
            android:id="@+id/action_createPartyFragment_to_departureMapFragment"
            app:destination="@id/departureMapFragment" />
        <action
            android:id="@+id/action_createPartyFragment_to_arrivalSearchFragment"
            app:destination="@id/arrivalSearchFragment" />
        <action
            android:id="@+id/action_createPartyFragment_to_matchDetailFragment"
            app:destination="@id/matchDetailFragment"
            app:popUpTo="@id/homeFragment"/>
    </fragment>

    <fragment
        android:id="@+id/showPartyFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.showparty.ShowPartyFragment"
        android:label="ShowPartyFragment">
        <action
            android:id="@+id/action_showPartyFragment_to_showPartySearchFragment"
            app:destination="@id/showPartySearchFragment" />
        <action
            android:id="@+id/action_showPartyFragment_to_createPartyFragment"
            app:destination="@id/createPartyFragment" />
        <action
            android:id="@+id/action_showPartyFragment_to_selectSpotFilterBottomSheetFragment"
            app:destination="@id/selectSpotFilterBottomSheetFragment" />
    </fragment>

    <fragment
        android:id="@+id/arrivalMapFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.createparty.arrival.ArrivalMapFragment"
        android:label="ArrivalMapFragment">

        <argument
            android:name="selectLocation"
            app:argType="com.motax.modutaxi.presentation.ui.MtLocation" />

        <action
            android:id="@+id/action_arrivalMapFragment_to_createPartyFragment"
            app:destination="@id/createPartyFragment"
            app:popUpTo="@id/createPartyFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/departureSearchFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.createparty.search.DepartureSearchFragment"
        android:label="DepartureSearchFragment" />
    <fragment
        android:id="@+id/arrivalSearchFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.createparty.search.ArrivalSearchFragment"
        android:label="ArrivalSearchFragment">
        <action
            android:id="@+id/action_arrivalSearchFragment_to_arrivalMapFragment"
            app:destination="@id/arrivalMapFragment" />
    </fragment>
    <fragment
        android:id="@+id/myPageFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.mypage.MyPageFragment"
        android:label="MyPageFragment">
        <action
            android:id="@+id/action_mypage_to_edit_nick"
            app:destination="@id/fragment_mypage_edit_nickname"
            app:popUpTo="@id/myPageFragment"/>
        <action
            android:id="@+id/action_myPage_to_update_profile"
            app:destination="@id/myPageIdentificationFragment" />
        <action
            android:id="@+id/action_myPage_to_authorize_school"
            app:destination="@id/myPageEnterEmailFragment"/>
        <action
            android:id="@+id/action_myPage_to_usage_history"
            app:destination="@id/usageHistoryFragment"/>
        <action
            android:id="@+id/action_myPage_to_inquiry"
            app:destination="@id/inquiryFragment"/>
        <action
            android:id="@+id/action_myPage_to_withdrawal"
            app:destination="@id/withdrawalExplanationFragment"/>
        <action
            android:id="@+id/action_myPage_to_account"
            app:destination="@id/accountFragment"/>
    </fragment>

    <fragment
        android:id="@+id/usageDetailsFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.mypage.usagedetail.UsageDetailsFragment"
        android:label="UsageDetailFragment">

        <argument
            android:name="id"
            app:argType="long" />

        <action
            android:id="@+id/action_details_to_history"
            app:destination="@id/usageHistoryFragment">
        </action>

    </fragment>

    <fragment
        android:id="@+id/usageHistoryFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.mypage.usagehistory.UsageHistoryFragment"
        android:label="UsageHistoryFragment">
        <action
            android:id="@+id/action_history_to_detail"
            app:destination="@id/usageDetailsFragment"/>
    </fragment>


    <fragment
        android:id="@+id/inquiryFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.mypage.inquiry.InquiryFragment"
        android:label="InquiryFragment"/>

    <fragment
        android:id="@+id/myPageEnterEmailFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.mypage.editemail.MyPageSchoolAuthorizationEnterEmailFragment"
        android:label="EditEmailFragment">
        <action
            android:id="@+id/action_emailAuthFragment_to_emailAuthFragment"
            app:destination="@id/myPageEmailAuthFragment"/>
    </fragment>

    <fragment
        android:id="@+id/myPageEmailAuthFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.mypage.emailauth.MyPageSchoolAuthorizationEnterCodeFragment"
        tools:layout="@layout/fragment_mypage_school_authorization_enter_code">

        <argument
            android:name="email"
            app:argType="string" />

    </fragment>
    <fragment
        android:id="@+id/fragment_mypage_edit_nickname"
        android:name="com.motax.modutaxi.presentation.ui.main.mypage.editnick.MyPageEditNickFragment"
        android:label="EditNicknameFragment"/>
    <fragment
        android:id="@+id/matchDetailFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.matchdetail.MatchDetailFragment"
        android:label="MatchDetailFragment">

        <argument
            android:name="id"
            app:argType="long" />
        <action
            android:id="@+id/action_matchDetailFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/main_nav" />
        <action
            android:id="@+id/action_matchDetailFragment_to_chatRoomFragment"
            app:destination="@id/chatRoomFragment" />
    </fragment>

    <action
        android:id="@+id/global_action_to_matchDetailFragment"
        app:destination="@id/matchDetailFragment"/>
    <fragment
        android:id="@+id/showPartySearchFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.showparty.search.ShowPartySearchFragment"
        android:label="ShowPartySearchFragment" >
        <action
            android:id="@+id/action_showPartySearchFragment_to_showPartyFragment"
            app:destination="@id/showPartyFragment" />
    </fragment>
    <fragment
        android:id="@+id/chatRoomFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.chat.ChatRoomFragment"
        android:label="ChatRoomFragment">

        <argument
            android:name="id"
            app:argType="long" />
        <action
            android:id="@+id/action_chatRoomFragment_to_calculateSplashFragment"
            app:destination="@id/calculateSplashFragment" />
        <action
            android:id="@+id/action_chatRoomFragment_to_paymentFragment"
            app:destination="@id/paymentFragment" />
        <action
            android:id="@+id/action_chatRoomFragment_to_paymentStateFragment"
            app:destination="@id/paymentStateFragment" />
        <action
            android:id="@+id/action_chatRoomFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false"/>
        <action
            android:id="@+id/action_chatRoomFragment_to_editRoomFragment"
            app:destination="@id/editRoomFragment" />
        <action
            android:id="@+id/action_chatRoomFragment_to_imageEnlargeFragment"
            app:destination="@id/imageEnlargeFragment" />
        <action
            android:id="@+id/action_chatRoomFragment_to_profileBottomSheetFragment"
            app:destination="@id/profileBottomSheetFragment" />

    </fragment>
    <dialog
        android:id="@+id/selectSpotFilterBottomSheetFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.showparty.bottomsheet.SelectSpotFilterBottomSheetFragment"
        android:label="SelectSpotFilterBottomSheetFragment" />

    <fragment
        android:id="@+id/myPagePhoneAuthFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.mypage.phoneauth.MyPagePhoneAuthorization"
        android:label="myPagePhoneAuthorization"/>

    <fragment
        android:id="@+id/myPageIdentificationFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.mypage.identification.MyPageIdentificationFragment"
        android:label="myPageIdentification">
        <action
            android:id="@+id/action_identificationFragment_to_phoneAuthFragment"
            app:destination="@id/myPagePhoneAuthFragment" />
    </fragment>

    <fragment
        android:id="@+id/withdrawalExplanationFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.mypage.withdrawal.explanation.ExplanationFragment"
        android:label="explanation">
        <action
            android:id="@+id/action_explanation_to_reason"
            app:destination="@id/withdrawalReasonFragment"/>

    </fragment>

    <fragment
        android:id="@+id/withdrawalReasonFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.mypage.withdrawal.reason.ReasonFragment"
        android:label="reason">
        <action
            android:id="@+id/action_reason_to_confirm"
            app:destination="@id/withdrawalConfirmFragment"/>
    </fragment>

    <fragment
        android:id="@+id/withdrawalConfirmFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.mypage.withdrawal.confirm.ConfirmFragment"
        android:label="confirm">
        <action
            android:id="@+id/action_confirm_to_complete"
            app:destination="@id/withdrawalCompleteFragment"/>
    </fragment>

    <fragment
        android:id="@+id/withdrawalCompleteFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.mypage.withdrawal.complete.CompleteFragment"
        android:label="complete">
    </fragment>

    <fragment
        android:id="@+id/reportFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.report.ReportFragment"
        android:label="report">
        <argument
            android:name="targetId"
            app:argType="long"/>
        <argument
            android:name="roomId"
            app:argType="long"/>
    </fragment>

    <fragment
        android:id="@+id/accountFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.mypage.account.AccountFragment"
        android:label="account">
    </fragment>

    <fragment
        android:id="@+id/notificationFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.notification.NotificationFragment"
        android:label="notification">

        <action
            android:id="@+id/action_notification_to_matchdetail"
            app:destination="@id/matchDetailFragment"/>

    </fragment>
    <fragment
        android:id="@+id/calculateSplashFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.chat.calculate.CalculateSplashFragment"
        android:label="CalculateSplashFragment" >
        <action
            android:id="@+id/action_calculateSplashFragment_to_calculateEditAmountFragment"
            app:destination="@id/calculateEditAmountFragment" />
    </fragment>
    <fragment
        android:id="@+id/paymentFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.chat.payment.PaymentFragment"
        android:label="PaymentFragment" />
    <fragment
        android:id="@+id/paymentStateFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.chat.paymentstate.PaymentStateFragment"
        android:label="PaymentStateFragment" />
    <fragment
        android:id="@+id/calculateEditAmountFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.chat.calculate.editamount.CalculateEditAmountFragment"
        android:label="CalculateEditAmountFragment" >
        <action
            android:id="@+id/action_calculateEditAmountFragment_to_calculateEditAccountFragment"
            app:destination="@id/calculateEditAccountFragment" />
    </fragment>
    <fragment
        android:id="@+id/calculateEditAccountFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.chat.calculate.editaccount.CalculateEditAccountFragment"
        android:label="CalculateEditAccountFragment" >
        <action
            android:id="@+id/action_calculateEditAccountFragment_to_calculateEditAccountOwnerFragment"
            app:destination="@id/calculateEditAccountOwnerFragment" />
    </fragment>
    <fragment
        android:id="@+id/calculateConfirmFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.chat.calculate.confirm.CalculateConfirmFragment"
        android:label="CalculateConfirmFragment" >
        <action
            android:id="@+id/action_calculateConfirmFragment_to_calculateCompleteFragment"
            app:destination="@id/calculateCompleteFragment" />
    </fragment>
    <fragment
        android:id="@+id/calculateCompleteFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.chat.calculate.complete.CalculateCompleteFragment"
        android:label="CalculateCompleteFragment" >
        <action
            android:id="@+id/action_calculateCompleteFragment_to_chatRoomFragment"
            app:destination="@id/chatRoomFragment"
            app:popUpTo="@id/matchDetailFragment"/>
    </fragment>
    <fragment
        android:id="@+id/calculateEditAccountOwnerFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.chat.calculate.accountowner.CalculateEditAccountOwnerFragment"
        android:label="CalculateEditAccountOwnerFragment" >
        <action
            android:id="@+id/action_calculateEditAccountOwnerFragment_to_calculateConfirmFragment"
            app:destination="@id/calculateConfirmFragment" />
    </fragment>
    <fragment
        android:id="@+id/editRoomFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.chat.editroom.EditRoomFragment"
        android:label="EditRoomFragment" >
        <argument
            app:argType="long"
            android:name="roomId"/>

    </fragment>
    <fragment
        android:id="@+id/imageEnlargeFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.chat.image.ImageEnlargeFragment"
        android:label="ImageEnlargeFragment" >

        <argument
            app:argType="string"
            android:name="imageUrl"/>

    </fragment>
    <dialog
        android:id="@+id/profileBottomSheetFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.chat.bottomsheet.ProfileBottomSheetFragment"
        android:label="ProfileBottomSheetFragment" >
        <argument
            app:argType="long"
            android:name="id"/>

    </dialog>

</navigation>