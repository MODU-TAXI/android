<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_nav"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.home.HomeFragment"
        android:label="HomeFragment">
        <action
            android:id="@+id/action_homeFragment_to_createPartyFragment"
            app:destination="@id/createPartyFragment" />
        <action
            android:id="@+id/action_homeFragment_to_showPartyFragment"
            app:destination="@id/showPartyFragment" />
    </fragment>

    <fragment
        android:id="@+id/departureMapFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.createparty.departuremap.DepartureMapFragment"
        android:label="MapFragment">
        <action
            android:id="@+id/action_departureMapFragment_to_addressSearchFragment"
            app:destination="@id/addressSearchFragment" />
    </fragment>

    <fragment
        android:id="@+id/taxiPotListFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.partylist.TaxiPotListFragment"
        android:label="TaxiPotListFragment" />

    <fragment
        android:id="@+id/createPartyFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.createparty.CreatePartyFragment"
        android:label="CreatePartyFragment">
        <action
            android:id="@+id/action_createPartyFragment_to_departureMapFragment"
            app:destination="@id/departureMapFragment" />
        <action
            android:id="@+id/action_createPartyFragment_to_addressSearchFragment"
            app:destination="@id/addressSearchFragment" />
    </fragment>

    <fragment
        android:id="@+id/showPartyFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.showparty.ShowPartyFragment"
        android:label="ShowPartyFragment" />

    <fragment
        android:id="@+id/arrivalMapFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.createparty.arrivalmap.ArrivalMapFragment"
        android:label="ArrivalMapFragment">
        <action
            android:id="@+id/action_arrivalMapFragment_to_createPartyFragment"
            app:destination="@id/createPartyFragment"
            app:popUpTo="@id/createPartyFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/addressSearchFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.createparty.search.AddressSearchFragment"
        android:label="AddressSearchFragment">

        <argument
            app:argType="string"
            android:name="type"/>

        <action
            android:id="@+id/action_addressSearchFragment_to_arrivalMapFragment"
            app:destination="@id/arrivalMapFragment"
            app:popUpTo="@id/createPartyFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/secondFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.home.temp.SecondFragment"
        android:label="SecondFragment" />

    <fragment
        android:id="@+id/thirdFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.home.temp.ThirdFragment"
        android:label="ThirdFragment" />

    <fragment
        android:id="@+id/fourthFragment"
        android:name="com.motax.modutaxi.presentation.ui.main.home.temp.FourthFragment"
        android:label="FourthFragment" />



</navigation>