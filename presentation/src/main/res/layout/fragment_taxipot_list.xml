<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="vm"
            type="com.motax.modutaxi.presentation.ui.main.taxipotlist.TaxiPotListViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_02_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.02" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_07_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.07" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_09_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.09" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_13_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.13" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_04_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.04" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_96_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.96" />

        <ImageView
            android:id="@+id/btn_backward"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/btn_backward"
            app:layout_constraintBottom_toTopOf="@id/guide_07_horizontal"
            app:layout_constraintStart_toEndOf="@id/guide_04_vertical"
            app:layout_constraintTop_toBottomOf="@id/guide_02_horizontal"></ImageView>

        <TextView
            style="@style/TextTitle3Semibold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="택시팟 목록"
            app:layout_constraintBottom_toTopOf="@id/guide_07_horizontal"
            app:layout_constraintEnd_toStartOf="@id/btn_xmark"
            app:layout_constraintStart_toEndOf="@id/btn_backward"
            app:layout_constraintTop_toBottomOf="@id/guide_02_horizontal"></TextView>

        <ImageView
            android:id="@+id/btn_xmark"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:src="@drawable/btn_xmark"
            app:layout_constraintBottom_toTopOf="@id/guide_07_horizontal"
            app:layout_constraintEnd_toStartOf="@id/guide_96_vertical"
            app:layout_constraintTop_toBottomOf="@id/guide_02_horizontal"></ImageView>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_classify_destination"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/rect_grey_fill_nostroke_37radius"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            app:layout_constraintBottom_toTopOf="@id/guide_13_horizontal"
            app:layout_constraintStart_toEndOf="@id/guide_04_vertical"
            app:layout_constraintTop_toBottomOf="@id/guide_09_horizontal">

            <ImageView
                android:id="@+id/iv_magnifying_glass"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:src="@drawable/btn_magnifying_glass"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"></ImageView>

            <TextView
                android:id="@+id/tv_destination"
                style="@style/TextRegularRegular"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="도착지"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/iv_magnifying_glass"
                app:layout_constraintTop_toTopOf="parent"></TextView>

            <ImageView
                android:id="@+id/btn_xmark_clear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:src="@drawable/btn_xmark_circle_fill"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/tv_destination"
                app:layout_constraintTop_toTopOf="parent"></ImageView>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_classify_student_verification"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:background="@drawable/rect_grey_fill_nostroke_37radius"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            app:layout_constraintBottom_toTopOf="@id/guide_13_horizontal"
            app:layout_constraintStart_toEndOf="@id/layout_classify_destination"
            app:layout_constraintTop_toBottomOf="@id/guide_09_horizontal">

            <TextView
                android:id="@+id/tv_student_verification"
                style="@style/TextRegularRegular"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="학생인증"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"></TextView>


        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_classify_women_only"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:background="@drawable/rect_grey_fill_nostroke_37radius"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            app:layout_constraintBottom_toTopOf="@id/guide_13_horizontal"
            app:layout_constraintStart_toEndOf="@id/layout_classify_student_verification"
            app:layout_constraintTop_toBottomOf="@id/guide_09_horizontal">

            <TextView
                android:id="@+id/tv_women_only"
                style="@style/TextRegularRegular"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="여자만"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            </TextView>


        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_classify_manners_boarding"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:background="@drawable/rect_grey_fill_nostroke_37radius"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            app:layout_constraintBottom_toTopOf="@id/guide_13_horizontal"
            app:layout_constraintStart_toEndOf="@id/layout_classify_women_only"
            app:layout_constraintTop_toBottomOf="@id/guide_09_horizontal">

            <TextView
                android:id="@+id/tv_manners_boarding"
                style="@style/TextRegularRegular"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="매너 탑승"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            </TextView>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_deadline_and_toggle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="@id/guide_96_vertical"
            app:layout_constraintStart_toStartOf="@id/guide_04_vertical"
            app:layout_constraintTop_toBottomOf="@id/guide_13_horizontal">

            <ImageView
                android:id="@+id/btn_deadline_imminent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:src="@drawable/btn_ellipse_no_fill"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"></ImageView>

            <TextView
                style="@style/TextRegularRegular"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="마감임박"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/btn_deadline_imminent"
                app:layout_constraintTop_toTopOf="parent"></TextView>

            <TextView
                android:id="@+id/tv_sorting_option"
                style="@style/TextRegularRegular"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="4dp"
                android:text="최신순"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btn_toggle_check"
                app:layout_constraintTop_toTopOf="parent"></TextView>

            <ImageView
                android:id="@+id/btn_toggle_check"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingHorizontal="2dp"
                android:paddingVertical="6dp"
                android:src="@drawable/btn_chevron_down"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"></ImageView>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh_layout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guide_96_vertical"
            app:layout_constraintStart_toEndOf="@id/guide_04_vertical"
            app:layout_constraintTop_toBottomOf="@+id/layout_deadline_and_toggle">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_taxipot_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:list="@{vm.uiState.taxiPotList}" />

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

</layout>