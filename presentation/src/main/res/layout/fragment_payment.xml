<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="vm"
            type="com.motax.modutaxi.presentation.ui.main.chat.payment.PaymentViewModel" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/tv_name"
            style="@style/TextTitle1Semibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="40dp"
            android:text="@{vm.uiState.name + `님에게`}"
            android:textSize="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="김민우님에게" />

        <TextView
            android:id="@+id/tv_howmuch"
            style="@style/TextTitle1Semibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@{vm.uiState.chargeString}"
            android:textColor="@color/mx_sub500"
            android:textSize="24dp"
            app:layout_constraintStart_toStartOf="@id/tv_name"
            app:layout_constraintTop_toBottomOf="@id/tv_name"
            tools:text="2,650원" />

        <TextView
            android:id="@+id/tv_send_announce"
            style="@style/TextTitle1Semibold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="을 송금해주세요"
            android:textSize="24dp"
            app:layout_constraintBottom_toBottomOf="@id/tv_howmuch"
            app:layout_constraintStart_toEndOf="@id/tv_howmuch"
            app:layout_constraintTop_toTopOf="@id/tv_howmuch" />

        <ImageView
            android:id="@+id/btn_toss_pay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="24dp"
            android:scaleType="centerCrop"
            android:src="@drawable/btn_toss_pay"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_howmuch" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/rect_directsendbtn_nostroke_12radius"
            android:paddingHorizontal="20dp"
            android:paddingVertical="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btn_toss_pay">

            <ImageView
                android:id="@+id/iv_bank"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:src="@drawable/ic_bank_woori" />

            <TextView
                android:id="@+id/tv_direct_send"
                style="@style/TextLargeSemibold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="직접 송금하기"
                android:textColor="@color/mx_gray700"
                android:textSize="16dp"
                app:layout_constraintBottom_toBottomOf="@id/iv_bank"
                app:layout_constraintStart_toEndOf="@id/iv_bank"
                app:layout_constraintTop_toTopOf="@id/iv_bank" />

            <TextView
                android:id="@+id/tv_bank"
                style="@style/TextSmallMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{vm.uiState.bankName}"
                android:textColor="@color/mx_gray600"
                android:textSize="12dp"
                app:layout_constraintStart_toStartOf="@id/tv_direct_send"
                app:layout_constraintTop_toBottomOf="@id/tv_direct_send"
                tools:text="카카오뱅크" />

            <TextView
                android:id="@+id/tv_account"
                style="@style/TextSmallMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:text="@{vm.uiState.accountString}"
                android:textColor="@color/mx_gray600"
                android:textSize="12dp"
                app:layout_constraintBottom_toBottomOf="@id/tv_bank"
                app:layout_constraintStart_toEndOf="@id/tv_bank"
                tools:text="321321564645" />

            <ImageView
                android:id="@+id/btn_clip_copy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_clip_board"
                android:onClick="@{() -> vm.copyClipBoard()}"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_confirm"
            style="@style/TextLargeSemibold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/rect_sub500fill_nostroke_61radius"
            android:gravity="center"
            android:paddingVertical="16dp"
            android:onClick="@{() -> vm.paymentComplete()}"
            android:text="정산완료"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>