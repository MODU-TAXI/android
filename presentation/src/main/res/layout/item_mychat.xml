<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="item"
            type="com.motax.modutaxi.presentation.ui.main.chat.model.UiChatMessage" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tv_message"
            style="@style/TextRegularRegular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/rect_sub500fill_nostroke_mychatradius"
            android:maxWidth="200dp"
            android:paddingHorizontal="16dp"
            android:text="@{item.content}"
            android:paddingVertical="10dp"
            android:textColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="우왕 개이득 ㅋㅋㅋㅋ" />

        <TextView
            android:id="@+id/tv_read_count"
            style="@style/TextCaptionRegular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            app:layout_constraintBottom_toTopOf="@id/tv_time"
            app:layout_constraintEnd_toEndOf="@id/tv_time"
            tools:text="2" />

        <TextView
            android:id="@+id/tv_time"
            style="@style/TextCaptionRegular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:text="@{item.sentTime}"
            android:textColor="@color/mx_gray300"
            app:layout_constraintBottom_toBottomOf="@id/tv_message"
            app:layout_constraintEnd_toStartOf="@id/tv_message"
            tools:text="14:15" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>