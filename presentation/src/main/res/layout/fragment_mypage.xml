<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="vm"
            type="com.motax.modutaxi.presentation.ui.main.mypage.MyPageViewModel" />

    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingBottom="200dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guide_09_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.09" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guide_32_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintGuide_percent="0.32" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guide_04_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.04" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guide_96_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.96" />


            <TextView
                android:id="@+id/tv_mypage_label"
                style="@style/TextTitle3Medium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="36dp"
                android:text="마이페이지"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_profile_image"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:clipToOutline="true"
                android:layout_marginTop="40dp"
                app:layout_constraintTop_toBottomOf="@id/tv_mypage_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <ImageView
                    android:id="@+id/iv_profile_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_mypage_profile"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:profileImgUrl="@{vm.uiState.imageUrl}" />

                <ImageView
                    android:id="@+id/iv_profile_change"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/ic_camera"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                style="@style/TextSmallMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="32dp"
                android:gravity="center"
                android:text="귀하는 현재 신고처리 대상자입니다..."
                android:textColor="#FF4949"
                android:visibility="@{vm.uiState.isReported ? View.GONE : View.VISIBLE}"
                app:layout_constraintBottom_toTopOf="@id/layout_first"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layout_profile_image" />


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_first"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/rect_nofill_gray100stroke_12radius"
                android:padding="16dp"
                android:layout_marginTop="30dp"
                app:layout_constraintTop_toBottomOf="@id/layout_profile_image"
                app:layout_constraintEnd_toStartOf="@id/guide_96_vertical"
                app:layout_constraintStart_toEndOf="@id/guide_04_vertical">

                <TextView
                    android:id="@+id/tv_nickname_label"
                    style="@style/TextRegularSemibold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="닉네임"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tv_nickname"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:onClick="@{() -> vm.navigateToEditNick()}"
                    android:text="@{vm.uiState.nickname}"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:text="델로" />

                <ImageView
                    android:id="@+id/iv_dash_line1"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="16dp"
                    android:src="@drawable/dash_line_gray_d9d9d9"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_nickname_label" />




                <TextView
                    android:id="@+id/tv_student_verification_label"
                    style="@style/TextRegularSemibold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="학교 인증"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/iv_dash_line1" />

                <TextView
                    android:id="@+id/tv_student_verification"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:onClick="@{() -> vm.navigateToEditEmail()}"
                    android:text="@{vm.uiState.certified ? `인증됨` : `미인증`}"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_student_verification_label"
                    tools:text="미인증" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_second"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/rect_nofill_gray100stroke_12radius"
                android:padding="16dp"
                app:layout_constraintEnd_toStartOf="@id/guide_96_vertical"
                app:layout_constraintStart_toEndOf="@id/guide_04_vertical"
                app:layout_constraintTop_toBottomOf="@id/layout_first">


                <TextView
                    android:id="@+id/tv_change_personal_information"
                    style="@style/TextRegularSemibold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="개인정보 수정"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <ImageView
                    android:id="@+id/iv_to_change_personal_information"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="@{() -> vm.navigateToUpdateProfile()}"
                    android:src="@drawable/ic_navigate_next_mypage"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_change_personal_information" />

                <ImageView
                    android:id="@+id/iv_dash_line2"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_marginVertical="16dp"
                    android:src="@drawable/dash_line_gray_d9d9d9"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_change_personal_information" />


                <TextView
                    android:id="@+id/tv_account_management"
                    style="@style/TextRegularSemibold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="계좌관리"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/iv_dash_line2"/>

                <ImageView
                    android:id="@+id/iv_to_account_management"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="@{() -> vm.navigateToAccount()}"
                    android:src="@drawable/ic_navigate_next_mypage"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_account_management" />

                <ImageView
                    android:id="@+id/iv_dash_line3"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="16dp"
                    android:src="@drawable/dash_line_gray_d9d9d9"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_account_management" />

                <TextView
                    android:id="@+id/tv_usage_history_label"
                    style="@style/TextRegularSemibold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="이용내역"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/iv_dash_line3" />

                <ImageView
                    android:id="@+id/iv_to_usage_history"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="@{() -> vm.navigateToUsageHistory()}"
                    android:src="@drawable/ic_navigate_next_mypage"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_usage_history_label" />

                <ImageView
                    android:id="@+id/iv_dash_line4"
                    android:layout_width="0dp"
                    android:layout_height="2dp"
                    android:layout_marginTop="16dp"
                    android:src="@drawable/dash_line_gray_d9d9d9"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_usage_history_label" />


                <TextView
                    android:id="@+id/tv_inquiry_label"
                    style="@style/TextRegularSemibold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="문의하기"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/iv_dash_line4" />

                <ImageView
                    android:id="@+id/iv_to_inquiry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="@{() -> vm.navigateToInquiry()}"
                    android:src="@drawable/ic_navigate_next_mypage"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tv_inquiry_label" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/tv_logout"
                style="@style/TextRegularRegular"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="로그아웃"
                android:textColor="@color/mx_gray500"
                app:layout_constraintEnd_toStartOf="@id/vertical_bar_first"
                app:layout_constraintTop_toBottomOf="@id/layout_second" />

            <ImageView
                android:id="@+id/vertical_bar_first"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="16dp"
                android:src="@drawable/vertical_bar"
                app:layout_constraintBottom_toBottomOf="@id/tv_logout"
                app:layout_constraintEnd_toEndOf="@id/layout_profile_image"
                app:layout_constraintStart_toStartOf="@id/layout_profile_image"
                app:layout_constraintTop_toTopOf="@id/tv_logout" />

            <TextView
                android:id="@+id/tv_withdrawal"
                style="@style/TextRegularRegular"
                android:layout_width="56dp"
                android:layout_height="24dp"
                android:gravity="center"
                android:onClick="@{() -> vm.navigateToWithdrawal()}"
                android:text="회원탈퇴"
                android:textColor="@color/mx_gray500"
                app:layout_constraintBottom_toBottomOf="@id/tv_logout"
                app:layout_constraintStart_toEndOf="@id/vertical_bar_first"
                app:layout_constraintTop_toTopOf="@id/tv_logout" />


        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</layout>