<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="vm"
            type="com.motax.modutaxi.presentation.ui.main.home.HomeViewModel" />

    </data>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        android:layout_marginBottom="75dp"
        android:paddingTop="?attr/actionBarSize">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guide_04_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.04" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guide_96_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.96" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/guide_50_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_percent="0.50" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_top_section"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_nav"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guide_04_vertical1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.04" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guide_96_vertical1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.96" />

                <ImageView
                    android:id="@+id/tv_app_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:src="@drawable/ic_modutaxi"
                    app:layout_constraintStart_toEndOf="@id/guide_04_vertical1"
                    app:layout_constraintTop_toTopOf="parent"/>

                <ImageView
                    android:id="@+id/ic_notification"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:src="@drawable/ic_notification"
                    android:paddingRight="10dp"
                    app:layout_constraintEnd_toStartOf="@id/guide_96_vertical1"
                    app:layout_constraintTop_toTopOf="parent"/>

                <TextView
                    android:id="@+id/tv_welcome_message"
                    style="@style/TextTitle3Medium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="정현님! 모두의 택시를 이용하고 계시는군요!"
                    android:textColor="@color/white"
                    app:layout_constraintStart_toEndOf="@id/guide_04_vertical1"
                    app:layout_constraintTop_toBottomOf="@id/tv_app_name" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_search"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="18dp"
                    android:background="@drawable/rect_white0_fill_nostroke_12_radius"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/guide_96_vertical1"
                    app:layout_constraintStart_toEndOf="@id/guide_04_vertical1"
                    app:layout_constraintTop_toBottomOf="@id/tv_welcome_message">

                    <ImageView
                        android:id="@+id/ic_search"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginLeft="12dp"
                        android:src="@drawable/ic_magnifying_glass_mint"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <EditText
                        android:id="@+id/et_search"
                        style="@style/TextRegularMedium"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginLeft="4dp"
                        android:background="@null"
                        android:hint="우리 오늘 어디로 떠날까요?"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/ic_search"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <ImageView
                android:id="@+id/iv_make_taxipot"
                android:layout_width="0dp"
                android:layout_height="237dp"
                android:layout_marginTop="18dp"
                android:layout_marginRight="8dp"
                android:background="@color/mx_gray200"
                android:src="@drawable/ic_example"
                app:layout_constraintEnd_toStartOf="@id/iv_find_taxipot"
                app:layout_constraintStart_toEndOf="@id/guide_04_vertical"
                app:layout_constraintTop_toBottomOf="@id/layout_top_section" />

            <ImageView
                android:id="@+id/iv_find_taxipot"
                android:layout_width="0dp"
                android:layout_height="237dp"
                android:layout_marginLeft="8dp"
                android:layout_marginTop="18dp"
                android:background="@color/mx_gray500"
                android:src="@drawable/ic_example"
                app:layout_constraintEnd_toStartOf="@id/guide_96_vertical"
                app:layout_constraintStart_toEndOf="@id/iv_make_taxipot"
                app:layout_constraintTop_toBottomOf="@id/layout_top_section" />

            <View
                android:id="@+id/iv_contour_first"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="24dp"
                android:background="#F2F2F2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iv_make_taxipot" />

            <TextView
                android:id="@+id/tv_participating_taxipot"
                style="@style/TextLargeSemibold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:paddingLeft="4dp"
                android:text="내가 참여중인 택시팟"
                app:layout_constraintStart_toEndOf="@id/guide_04_vertical"
                app:layout_constraintTop_toBottomOf="@id/iv_contour_first" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layout_participating_taxipot"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/rect_nofill_gray200stroke_12radius"
                android:paddingHorizontal="12dp"
                android:paddingTop="12dp"
                android:paddingBottom="14dp"
                app:layout_constraintEnd_toStartOf="@id/guide_96_vertical"
                app:layout_constraintStart_toEndOf="@id/guide_04_vertical"
                app:layout_constraintTop_toBottomOf="@id/tv_participating_taxipot">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_departure_time"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rect_sub100fill_nostroke_8radius"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/iv_group_check"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_group_check"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_depart"
                        style="@style/TextSmallMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:text="출발"
                        android:textColor="@color/mx_sub500"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/iv_group_check"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_departure_datetime"
                        style="@style/TextSmallMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:textColor="@color/mx_sub500"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/tv_depart"
                        app:layout_constraintTop_toTopOf="parent"
                        android:text="14:25"
                        tools:text="14:25" />


                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/tv_departure"
                    style="@style/TextRegularSemibold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/layout_departure_time"
                    android:text="인하대학교"
                    tools:text="인하대학교" />

                <ImageView
                    android:id="@+id/ic_arrow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:src="@drawable/ic_arrow"
                    app:layout_constraintBottom_toBottomOf="@id/tv_departure"
                    app:layout_constraintStart_toEndOf="@id/tv_departure"
                    app:layout_constraintTop_toTopOf="@id/tv_departure" />

                <TextView
                    style="@style/TextRegularSemibold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    app:layout_constraintBottom_toBottomOf="@id/tv_departure"
                    app:layout_constraintStart_toEndOf="@id/ic_arrow"
                    app:layout_constraintTop_toTopOf="@id/tv_departure"
                    android:text="주안역"
                    tools:text="주안역" />

                <ImageView
                    android:id="@+id/iv_person_fill"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:src="@drawable/ic_person_fill"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_departure" />

                <TextView
                    android:id="@+id/tv_participants"
                    style="@style/TextSmallRegular"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:textColor="#969DA4"
                    app:layout_constraintBottom_toBottomOf="@id/iv_person_fill"
                    app:layout_constraintStart_toEndOf="@id/iv_person_fill"
                    app:layout_constraintTop_toTopOf="@+id/iv_person_fill"
                    android:text="2/3"
                    tools:text="2/3" />

                <ImageView
                    android:id="@+id/iv_pig"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:src="@drawable/ic_pig"
                    app:layout_constraintBottom_toBottomOf="@id/iv_person_fill"
                    app:layout_constraintStart_toEndOf="@id/tv_participants"
                    app:layout_constraintTop_toTopOf="@id/iv_person_fill" />

                <TextView
                    android:id="@+id/tv_per_person"
                    style="@style/TextSmallRegular"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="2dp"
                    android:text="인당 "
                    android:textColor="#969DA4"
                    app:layout_constraintBottom_toBottomOf="@id/iv_person_fill"
                    app:layout_constraintStart_toEndOf="@id/iv_pig"
                    app:layout_constraintTop_toTopOf="@id/iv_person_fill" />

                <TextView
                    android:id="@+id/tv_fee_per_person"
                    style="@style/TextSmallRegular"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:textColor="#969DA4"
                    app:layout_constraintBottom_toBottomOf="@id/iv_person_fill"
                    app:layout_constraintStart_toEndOf="@id/tv_per_person"
                    app:layout_constraintTop_toTopOf="@id/iv_person_fill"
                    android:text="8,300원"
                    tools:text="8,300원" />

                <androidx.appcompat.widget.AppCompatButton
                    style="@style/TextSmallMedium"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/rect_nofill_sub500stroke_8radius"
                    android:gravity="center"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="12dp"

                    android:text="채팅방 바로가기"
                    android:textColor="@color/mx_sub500"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/iv_person_fill" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <View
                android:id="@+id/iv_contour_second"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="24dp"
                android:background="#F2F2F2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layout_participating_taxipot" />

            <TextView
                android:id="@+id/tv_realtime_taxipot"
                style="@style/TextLargeSemibold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:paddingLeft="4dp"
                android:text="실시간 택시팟을 알려드려요!"
                app:layout_constraintStart_toEndOf="@id/guide_04_vertical"
                app:layout_constraintTop_toBottomOf="@id/iv_contour_second" />

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_navigate_next"
                app:layout_constraintBottom_toBottomOf="@id/tv_realtime_taxipot"
                app:layout_constraintEnd_toEndOf="@id/guide_96_vertical"
                app:layout_constraintTop_toTopOf="@id/tv_realtime_taxipot" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_realtime_taxipot_list"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintStart_toStartOf="@id/guide_04_vertical"
                app:layout_constraintTop_toBottomOf="@id/tv_realtime_taxipot"
                app:list="@{vm.uiState.realtimeTaxiPotList}"
                tools:listitem="@layout/item_realtime_taxipot" />

            <View
                android:id="@+id/iv_contour_third"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="24dp"
                android:background="#F2F2F2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rv_realtime_taxipot_list" />

            <TextView
                android:id="@+id/tv_usage_history"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="이용내역"
                style="@style/TextLargeSemibold"
                android:layout_marginTop="24dp"
                app:layout_constraintTop_toBottomOf="@id/iv_contour_third"
                app:layout_constraintStart_toStartOf="@id/guide_04_vertical" />

            <TextView
                android:id="@+id/my_matching_rate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="나의 매칭률"
                android:layout_marginTop="24dp"
                android:layout_marginLeft="8dp"
                style="@style/TextLargeSemibold"
                app:layout_constraintTop_toBottomOf="@id/iv_contour_third"
                app:layout_constraintStart_toEndOf="@id/guide_50_vertical"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:paddingVertical="16dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/rect_nofill_gray200stroke_12radius"
                android:layout_marginRight="8dp"
                app:layout_constraintEnd_toStartOf="@id/guide_50_vertical"
                app:layout_constraintTop_toBottomOf="@id/my_matching_rate"
                app:layout_constraintStart_toEndOf="@id/guide_04_vertical">

                <ImageView
                    android:id="@+id/ic_recipt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_receipt"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/tv_month"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    tools:text="5"
                    android:text="5"
                    style="@style/TextSmallMedium"
                    android:textColor="@color/mx_gray700"
                    android:layout_marginLeft="4dp"
                    app:layout_constraintStart_toEndOf="@id/ic_recipt"
                    app:layout_constraintTop_toTopOf="@id/ic_recipt"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="월 한 달 동안"
                    style="@style/TextSmallMedium"
                    android:textColor="@color/mx_gray700"
                    app:layout_constraintTop_toTopOf="@id/tv_month"
                    app:layout_constraintStart_toEndOf="@id/tv_month"/>

                <TextView
                    android:id="@+id/tv_saved_money"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    tools:text="16,700"
                    android:text="16,700"
                    android:textColor="#10A2F4"
                    style="@style/TextRegularSemibold"
                    android:layout_marginTop="4dp"
                    app:layout_constraintStart_toStartOf="@id/tv_month"
                    app:layout_constraintTop_toBottomOf="@id/tv_month"/>

                <TextView
                    android:id="@+id/tv_won"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="원"
                    style="@style/TextRegularSemibold"
                    android:textColor="#10A2F4"
                    app:layout_constraintStart_toEndOf="@id/tv_saved_money"
                    app:layout_constraintTop_toTopOf="@id/tv_saved_money"
                    app:layout_constraintBottom_toBottomOf="@id/tv_saved_money"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="아꼈어요!"
                    android:layout_marginLeft="2dp"
                    app:layout_constraintTop_toTopOf="@id/tv_won"
                    app:layout_constraintStart_toEndOf="@id/tv_won"
                    app:layout_constraintBottom_toBottomOf="@id/tv_won"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:paddingHorizontal="12dp"
                android:layout_marginTop="12dp"
                android:layout_marginLeft="8dp"
                android:paddingVertical="16dp"
                android:background="@drawable/rect_nofill_gray200stroke_12radius"
                app:layout_constraintTop_toBottomOf="@id/my_matching_rate"
                app:layout_constraintEnd_toEndOf="@id/guide_96_vertical"
                app:layout_constraintStart_toEndOf="@id/guide_50_vertical">

                <ImageView
                    android:id="@+id/ic_popper"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_popper"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:id="@+id/tv_now"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="현재 상위 "
                    style="@style/TextSmallMedium"
                    android:textColor="@color/mx_gray700"
                    android:layout_marginLeft="4dp"
                    app:layout_constraintStart_toEndOf="@id/ic_popper"
                    app:layout_constraintTop_toTopOf="@id/ic_popper"/>

                <TextView
                    android:id="@+id/tv_percent_sign"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    tools:text="1"
                    android:text="1"
                    style="@style/TextSmallMedium"
                    android:textColor="@color/mx_gray700"
                    app:layout_constraintTop_toTopOf="@id/tv_now"
                    app:layout_constraintStart_toEndOf="@id/tv_now"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="%에요!"
                    android:textColor="@color/mx_gray700"
                    style="@style/TextSmallMedium"
                    app:layout_constraintStart_toEndOf="@id/tv_percent_sign"
                    app:layout_constraintTop_toTopOf="@id/tv_percent_sign"/>

                <TextView
                    android:id="@+id/tv_matching_percent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="매칭률"
                    android:layout_marginTop="4dp"
                    style="@style/TextRegularSemibold"
                    android:textColor="#10A2F4"
                    app:layout_constraintStart_toStartOf="@id/tv_now"
                    app:layout_constraintTop_toBottomOf="@id/tv_now"/>

                <TextView
                    android:id="@+id/tv_percent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    tools:text="97"
                    android:text="97"
                    style="@style/TextRegularSemibold"
                    android:textColor="#10A2F4"
                    android:layout_marginLeft="2dp"
                    app:layout_constraintTop_toTopOf="@id/tv_matching_percent"
                    app:layout_constraintStart_toEndOf="@id/tv_matching_percent"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="%"
                    style="@style/TextRegularSemibold"
                    android:textColor="#10A2F4"
                    app:layout_constraintTop_toTopOf="@id/tv_percent"
                    app:layout_constraintStart_toEndOf="@id/tv_percent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>



        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</layout>