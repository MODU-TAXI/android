<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
        <variable
            name="vm"
            type="com.motax.modutaxi.presentation.ui.main.matchdetail.MatchDetailViewModel"/>
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="20dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_toolbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_backward"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_header"
                style="@style/TextTitle3Semibold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="매칭 페이지"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_xmark"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingBottom="150dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/layout_toolbar">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guide_04_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.04" />

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guide_96_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.96" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_classification"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    app:chipSpacing="4dp"
                    chipItems="@{vm.chipItems}"
                    app:layout_constraintStart_toStartOf="@id/guide_04_vertical"
                    app:layout_constraintTop_toTopOf="parent"
                    app:singleLine="true"/>

                <ImageView
                    android:id="@+id/layout_map"
                    android:layout_width="0dp"
                    android:layout_height="240dp"
                    android:src="@drawable/ic_logo"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@id/chip_group_classification"
                    app:layout_constraintStart_toEndOf="@id/guide_04_vertical"
                    app:layout_constraintEnd_toStartOf="@id/guide_96_vertical"/>

                <TextView
                    android:id="@+id/tv_departure_datetime"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    tools:text="2024.03.25 (월)"
                    style="@style/TextTitle3Medium"
                    android:text="@{vm.uiState.departureDairyDate}"
                    android:textColor="@color/mx_gray700"
                    android:layout_marginTop="32dp"
                    android:paddingLeft="8dp"
                    app:layout_constraintTop_toBottomOf="@id/layout_map"
                    app:layout_constraintStart_toEndOf="@id/guide_04_vertical"
                    app:layout_constraintEnd_toStartOf="@id/guide_96_vertical"/>

                <ImageView
                    android:id="@+id/iv_dotted_circle"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginTop="30dp"
                    android:layout_marginLeft="8dp"
                    android:src="@drawable/ic_dotted_circle_mint"
                    app:layout_constraintStart_toStartOf="@id/tv_departure_datetime"
                    app:layout_constraintTop_toBottomOf="@id/tv_departure_datetime" />

                <TextView
                    android:id="@+id/tv_departure_time"
                    style="@style/TextTitle3Regular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginBottom="2dp"
                    android:text="@{vm.uiState.departureTime}"
                    tools:text="13:35"
                    android:textColor="@color/mx_gray500"
                    app:layout_constraintTop_toTopOf="@id/iv_dotted_circle"
                    app:layout_constraintBottom_toBottomOf="@id/iv_dotted_circle"
                    app:layout_constraintStart_toEndOf="@id/iv_dotted_circle" />

                <TextView
                    android:id="@+id/tv_departure"
                    style="@style/TextTitle3Semibold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@{vm.uiState.departureName}"
                    tools:text="인하대학교 후문"
                    app:layout_constraintStart_toStartOf="@id/tv_departure_time"
                    app:layout_constraintTop_toBottomOf="@id/tv_departure_time" />
                <ImageView
                    android:id="@+id/iv_stick"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:src="@drawable/ic_mint_stick"
                    app:layout_constraintEnd_toEndOf="@id/iv_dotted_circle"
                    app:layout_constraintStart_toStartOf="@id/iv_dotted_circle"
                    app:layout_constraintTop_toBottomOf="@id/iv_dotted_circle" />
                <ImageView
                    android:id="@+id/iv_mint_circle"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="20dp"
                    android:src="@drawable/ic_mint_circle"
                    app:layout_constraintDimensionRatio="1:1"
                    app:layout_constraintEnd_toEndOf="@id/iv_dotted_circle"
                    app:layout_constraintStart_toStartOf="@id/iv_dotted_circle"
                    app:layout_constraintTop_toBottomOf="@id/iv_stick" />

                <TextView
                    android:id="@+id/tv_arrival_time"
                    style="@style/TextTitle3Regular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginTop="2dp"
                    tools:text="14:00"
                    android:text="@{vm.uiState.arrivalTime}"
                    android:textColor="@color/mx_gray500"
                    app:layout_constraintBottom_toBottomOf="@id/iv_mint_circle"
                    app:layout_constraintStart_toEndOf="@id/iv_mint_circle"
                    app:layout_constraintTop_toTopOf="@id/iv_mint_circle" />

                <TextView
                    android:id="@+id/tv_arrival"
                    style="@style/TextTitle3Semibold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@{vm.uiState.arrivalName}"
                    tools:text="주안역"
                    app:layout_constraintStart_toStartOf="@id/tv_arrival_time"
                    app:layout_constraintTop_toBottomOf="@id/tv_arrival_time" />

                <ImageView
                    android:id="@+id/iv_dash_line1"
                    android:layout_width="0dp"
                    android:layout_height="1.5dp"
                    android:layout_marginTop="40dp"
                    android:layerType="software"
                    android:src="@drawable/dash_line_gray200"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_arrival" />

                <TextView
                    android:id="@+id/tv_room_manager_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="방장"
                    android:layout_marginTop="32dp"
                    style="@style/TextTitle3Semibold"
                    app:layout_constraintStart_toEndOf="@id/guide_04_vertical"
                    app:layout_constraintTop_toBottomOf="@id/iv_dash_line1"/>

                <ImageView
                    android:id="@+id/iv_room_manager"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_person"
                    android:layout_marginTop="16dp"
                    app:layout_constraintTop_toBottomOf="@id/tv_room_manager_label"
                    app:layout_constraintStart_toEndOf="@id/guide_04_vertical"/>

                <TextView
                    android:id="@+id/tv_room_manager_nickname"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    tools:text="버스를 놓친 사자"
                    style="@style/TextLargeMedium"
                    android:layout_marginLeft="4dp"
                    app:layout_constraintTop_toTopOf="@id/iv_room_manager"
                    app:layout_constraintBottom_toBottomOf="@id/iv_room_manager"
                    app:layout_constraintStart_toEndOf="@id/iv_room_manager"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="(나)"
                    style="@style/TextLargeMedium"
                    android:layout_marginLeft="4dp"
                    android:textColor="@color/mx_gray800"
                    app:layout_constraintStart_toEndOf="@id/tv_room_manager_nickname"
                    app:layout_constraintTop_toTopOf="@id/tv_room_manager_nickname"
                    app:layout_constraintBottom_toBottomOf="@id/tv_room_manager_nickname"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    tools:text="78%"
                    style="@style/TextLargeRegular"
                    android:textColor="@color/mx_gray500"
                    app:layout_constraintEnd_toStartOf="@id/guide_96_vertical"
                    app:layout_constraintTop_toTopOf="@id/iv_room_manager"
                    app:layout_constraintBottom_toBottomOf="@id/iv_room_manager"/>

                <TextView
                    android:id="@+id/tv_participant_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="참여멤버"
                    style="@style/TextTitle3Semibold"
                    android:layout_marginTop="64dp"
                    app:layout_constraintTop_toBottomOf="@id/iv_room_manager"
                    app:layout_constraintStart_toEndOf="@id/guide_04_vertical"/>

                <TextView
                    android:id="@+id/tv_participant_num"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    tools:text="2"
                    android:text="@{String.valueOf(vm.uiState.currentHeadcount)}"
                    style="@style/TextLargeRegular"
                    android:textColor="@color/mx_gray600"
                    android:layout_marginLeft="8dp"
                    app:layout_constraintStart_toEndOf="@id/tv_participant_label"
                    app:layout_constraintTop_toTopOf="@id/tv_participant_label"
                    app:layout_constraintBottom_toBottomOf="@id/tv_participant_label"/>

                <TextView
                    android:id="@+id/tv_slash"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="/"
                    style="@style/TextLargeRegular"
                    android:textColor="@color/mx_gray600"
                    app:layout_constraintStart_toEndOf="@id/tv_participant_num"
                    app:layout_constraintTop_toTopOf="@id/tv_participant_num"
                    app:layout_constraintBottom_toBottomOf="@id/tv_participant_num"/>

                <TextView
                    android:id="@+id/total_participants"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    tools:text="3"
                    android:text="@{String.valueOf(vm.uiState.wishHeadcount)}"
                    style="@style/TextLargeRegular"
                    android:textColor="@color/mx_gray600"
                    app:layout_constraintStart_toEndOf="@id/tv_slash"
                    app:layout_constraintTop_toTopOf="@id/tv_participant_num"
                    app:layout_constraintBottom_toBottomOf="@id/tv_participant_num"/>

                <TextView
                    android:id="@+id/total_participants_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="명"
                    style="@style/TextLargeRegular"
                    android:textColor="@color/mx_gray600"
                    app:layout_constraintStart_toEndOf="@+id/total_participants"
                    app:layout_constraintTop_toTopOf="@id/tv_participant_num"
                    app:layout_constraintBottom_toBottomOf="@id/tv_participant_num"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_participants"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintTop_toBottomOf="@id/tv_participant_label"
                    app:layout_constraintStart_toEndOf="@id/guide_04_vertical"
                    app:layout_constraintEnd_toStartOf="@id/guide_96_vertical"
                    app:list="@{vm.uiState.participantList}"/>

                <TextView
                    android:id="@+id/tv_waiting_member_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="대기멤버"
                    style="@style/TextTitle3Semibold"
                    android:layout_marginTop="64dp"
                    app:layout_constraintTop_toBottomOf="@id/rv_participants"
                    app:layout_constraintStart_toEndOf="@id/guide_04_vertical"/>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/layout_no_waiting_member"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:visibility="visible"
                    app:layout_constraintTop_toBottomOf="@id/tv_waiting_member_label"
                    app:layout_constraintStart_toEndOf="@id/guide_04_vertical"
                    >

                <ImageView
                    android:id="@+id/iv_no_waiting_member"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:src="@drawable/ic_person"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="현재 대기 멤버가 없어요"
                    style="@style/TextLargeRegular"
                    android:textColor="@color/mx_gray500"
                    android:layout_marginLeft="4dp"
                    app:layout_constraintTop_toTopOf="@id/iv_no_waiting_member"
                    app:layout_constraintBottom_toBottomOf="@id/iv_no_waiting_member"
                    app:layout_constraintStart_toEndOf="@id/iv_no_waiting_member"/>

                </androidx.constraintlayout.widget.ConstraintLayout>


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_waiting_member"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                    app:layout_constraintTop_toBottomOf="@id/layout_no_waiting_member"
                    app:layout_constraintStart_toEndOf="@id/guide_04_vertical"
                    app:layout_constraintEnd_toStartOf="@id/guide_96_vertical"
                    app:list="@{vm.uiState.participantList}"/>

                <ImageView
                    android:id="@+id/iv_dash_line2"
                    android:layout_width="0dp"
                    android:layout_height="1.5dp"
                    android:layout_marginTop="40dp"
                    android:layerType="software"
                    app:layout_goneMarginTop="32dp"
                    android:src="@drawable/dash_line_gray200"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/rv_waiting_member" />

                <TextView
                    android:id="@+id/total_price_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="총액"
                    style="@style/TextLargeMedium"
                    android:layout_marginTop="32dp"
                    android:layout_marginLeft="8dp"
                    android:textColor="@color/mx_gray500"
                    app:layout_constraintTop_toBottomOf="@id/iv_dash_line2"
                    app:layout_constraintStart_toEndOf="@id/guide_04_vertical"/>

                <TextView
                    android:id="@+id/total_price"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    tools:text="14,450"
                    android:text="@{String.valueOf(vm.uiState.expectedCharge)}"
                    style="@style/TextLargeMedium"
                    android:textColor="@color/mx_gray900"
                    android:layout_marginRight="8dp"
                    app:layout_constraintEnd_toStartOf="@id/guide_96_vertical"
                    app:layout_constraintTop_toTopOf="@id/total_price_label"
                    app:layout_constraintBottom_toBottomOf="@id/total_price_label"/>

                <TextView
                    android:id="@+id/matching_price_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="최소인원 매칭시"
                    style="@style/TextLargeMedium"
                    android:layout_marginTop="8dp"
                    android:layout_marginLeft="8dp"
                    android:textColor="@color/mx_gray500"
                    app:layout_constraintTop_toBottomOf="@id/total_price_label"
                    app:layout_constraintStart_toEndOf="@id/guide_04_vertical"/>

                <TextView
                    android:id="@+id/matching_price"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    tools:text="3,613"
                    android:text="@{String.valueOf(vm.uiState.expectedChargePerPerson)}"
                    style="@style/TextLargeMedium"
                    android:textColor="@color/mx_gray900"
                    android:layout_marginRight="8dp"
                    app:layout_constraintEnd_toStartOf="@id/guide_96_vertical"
                    app:layout_constraintTop_toTopOf="@id/matching_price_label"
                    app:layout_constraintBottom_toBottomOf="@id/matching_price_label"/>

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_participate"
                    style="@style/TextLargeSemibold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="154dp"
                    app:matchingParticipateBtnState="@{vm.uiState.myRoom}"
                    android:gravity="center"
                    android:paddingVertical="20dp"
                    android:text="@{vm.uiState.myRoom ? `매칭 수정하기` : `매칭 참여하기`}"
                    tools:text="매칭 참여하기"
                    android:visibility="visible"
                    app:layout_constraintEnd_toEndOf="@id/guide_96_vertical"
                    app:layout_constraintStart_toStartOf="@id/guide_04_vertical"
                    app:layout_constraintTop_toBottomOf="@id/matching_price" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_modify"
                    style="@style/TextLargeSemibold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="24dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/selector_create_btn"
                    android:gravity="center"
                    android:paddingVertical="20dp"
                    android:text="매칭 삭제하기"
                    android:visibility="@{vm.uiState.myRoom ? View.VISIBLE : View.GONE}"
                    android:textColor="@color/white"
                    app:layout_constraintEnd_toEndOf="@id/guide_96_vertical"
                    app:layout_constraintStart_toStartOf="@id/guide_04_vertical"
                    app:layout_constraintTop_toBottomOf="@id/btn_participate" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>