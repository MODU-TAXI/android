<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="vm"
            type="com.motax.modutaxi.presentation.ui.main.mypage.editnick.MyPageEditNickViewModel" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_09_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.09" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_81_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.81" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_08_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.08" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_10_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.10" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_90_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.90" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_92_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.92" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#D9D9D9"
            android:max="7"
            android:progress="3"
            android:progressTint="@color/mx_sub500"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_identification_description"
            style="@style/TextTitle1Semibold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="8dp"
            android:text="모두의 택시 이용을 위해\n닉네임을 설정해주세요!"
            android:textColor="#000000"
            android:textSize="24sp"
            app:layout_constraintStart_toEndOf="@id/guide_08_vertical"
            app:layout_constraintTop_toBottomOf="@id/guide_09_horizontal" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_enter_nickname"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@{vm.isNicknameValid ? @drawable/rect_nofill_gray500stroke_12radius : @drawable/rect_nofill_redstroke_12radius}"
            android:paddingHorizontal="22dp"
            android:paddingVertical="16dp"
            app:layout_constraintEnd_toStartOf="@id/guide_92_vertical"
            app:layout_constraintStart_toEndOf="@id/guide_08_vertical"
            app:layout_constraintTop_toBottomOf="@id/tv_identification_description">

            <TextView
                android:id="@+id/tv_name_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="닉네임"
                android:textColor="#626262"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/et_authorization_code"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@null"
                android:hint="한글, 영문 2~12자"
                android:text="@={vm.nick}"
                android:textColorHint="#C0C0C0"
                android:textSize="16sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_name_label" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tv_warning_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="@{vm.helperMessage}"
            android:textColor="#FF3131"
            android:textSize="12sp"
            android:visibility="@{vm.helperMessage.empty ? View.GONE : View.VISIBLE}"
            app:layout_constraintStart_toEndOf="@id/guide_08_vertical"
            app:layout_constraintTop_toBottomOf="@id/layout_enter_nickname"
            tools:text="닉네임은 최소 2글자부터 가능해요!" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_edit_nickname"
            style="@style/TextLargeSemibold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/selector_next_btn"
            android:enabled="@{vm.nick.empty ? false : true}"
            android:gravity="center"
            android:onClick="@{() -> vm.editNick()}"
            android:paddingVertical="16dp"
            android:text="확인"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:layout_constraintEnd_toStartOf="@id/guide_90_vertical"
            app:layout_constraintStart_toEndOf="@id/guide_10_vertical"
            app:layout_constraintTop_toBottomOf="@id/guide_81_horizontal" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>