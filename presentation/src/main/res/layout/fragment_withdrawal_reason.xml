<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />

        <variable
            name="vm"
            type="com.motax.modutaxi.presentation.ui.main.mypage.withdrawal.reason.ReasonViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="20dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_toolbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_backward"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_header"
                style="@style/TextTitle3Semibold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="회원탈퇴"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_xmark"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tv_nickname"
            style="@style/TextTitle3Semibold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginTop="36dp"
            android:text='@{vm.uiState.nickname + "님,"}'
            android:textColor="@color/mx_gray900"
            app:layout_constraintStart_toStartOf="@id/layout_toolbar"
            app:layout_constraintTop_toBottomOf="@id/layout_toolbar"
            tools:text="델로델로님," />

        <TextView
            android:id="@+id/tv_reason_label"
            style="@style/TextTitle3Semibold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="떠나시는 이유가 있으신가요?"
            android:textColor="@color/mx_gray900"
            app:layout_constraintStart_toStartOf="@id/tv_nickname"
            app:layout_constraintTop_toBottomOf="@id/tv_nickname" />

        <RadioGroup
            android:id="@+id/rg_reason"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_reason_label">

            <RadioButton
                android:theme="@style/CustomRadioButton"
                android:id="@+id/rb_not_use"
                style="@style/TextRegularMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="16dp"
                android:text="  택시를 잘 이용하지 않아요"
                android:textColor="@color/mx_gray700" />

            <RadioButton
                android:theme="@style/CustomRadioButton"
                android:id="@+id/rb_dont_know"
                style="@style/TextRegularMedium"
                android:layout_marginLeft="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  앱 사용 방법을 모르겠어요"
                android:textColor="@color/mx_gray700"/>

            <RadioButton
                android:theme="@style/CustomRadioButton"
                android:id="@+id/rb_error"
                style="@style/TextRegularMedium"
                android:layout_marginLeft="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  앱 오류가 많아요"
                android:textColor="@color/mx_gray700"/>

            <RadioButton
                android:theme="@style/CustomRadioButton"
                android:id="@+id/rb_resignup"
                style="@style/TextRegularMedium"
                android:layout_marginLeft="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  재가입이 필요해요"
                android:textColor="@color/mx_gray700"/>

            <RadioButton
                android:theme="@style/CustomRadioButton"
                android:id="@+id/rb_etc"
                style="@style/TextRegularMedium"
                android:layout_marginLeft="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  기타"
                android:textColor="@color/mx_gray700"/>
        </RadioGroup>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="136dp"
            android:background="@drawable/rect_gray100fill_nostroke_12radius"
            android:visibility="@{vm.uiState.showEtcReason ? View.VISIBLE : View.GONE}"
            app:layout_constraintEnd_toEndOf="@id/layout_toolbar"
            app:layout_constraintStart_toStartOf="@id/rg_reason"
            app:layout_constraintTop_toBottomOf="@id/rg_reason">

        <EditText
            android:id="@+id/tv_etc_reason"
            style="@style/TextSmallMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="top"
            android:hint="이유를 입력해주세요"
            android:inputType="textMultiLine"
            android:background="@null"
            android:backgroundTint="@android:color/transparent"
            android:maxLines="5"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:layout_marginHorizontal="4dp"
            android:text=""
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:textColor="@color/mx_gray500" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.appcompat.widget.AppCompatButton
            style="@style/TextLargeSemibold"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginLeft="34dp"
            android:layout_marginRight="34dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/rect_sub500fill_nostroke_61radius"
            android:gravity="center"
            android:paddingHorizontal="96dp"
            android:paddingVertical="10dp"
            android:onClick="@{() -> vm.navigateToConfirm() }"
            android:text="다음"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>