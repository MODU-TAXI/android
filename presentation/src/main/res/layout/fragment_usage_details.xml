<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="vm"
            type="com.motax.modutaxi.presentation.ui.main.mypage.usagedetail.UsageDetailsViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="20dp">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_04_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.04" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_96_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.96" />


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_toolbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:id="@+id/tv_header"
                style="@style/TextTitle3Semibold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이용내역"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_xmark"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_usage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="20dp"
            android:background="@drawable/rect_nofill_gray_eaeaea_stroke_20radius"
            app:layout_constraintEnd_toEndOf="@id/layout_toolbar"
            app:layout_constraintStart_toStartOf="@id/layout_toolbar"
            app:layout_constraintTop_toBottomOf="@id/layout_toolbar">

            <TextView
                android:id="@+id/tv_departure_arrival"
                style="@style/TextLargeSemibold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text='@{vm.uiState.usageDetailUiData.departureName + " -> " + vm.uiState.usageDetailUiData.arrivalName}'
                tools:text="인하대학교 -> 주안역"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <TextView
                android:id="@+id/tv_departure_datetime"
                style="@style/TextSmallRegular"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@{vm.uiState.usageDetailUiData.departureTime}"
                android:textColor="@color/mx_gray500"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_departure_arrival"
                tools:text="2024.03.25 18:50" />

            <View
                android:id="@+id/iv_dash_line1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/search_divider"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_departure_datetime"/>

            <TextView
                android:id="@+id/tv_room_manager_label"
                style="@style/TextRegularSemibold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="@color/mx_gray700"
                android:text="방장"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iv_dash_line1" />


            <ImageView
                android:id="@+id/iv_room_manager"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginTop="16dp"
                app:profileImgUrl="@{vm.uiState.owner.imageUrl}"
                tools:src="@drawable/ic_person"
                app:layout_constraintTop_toBottomOf="@id/tv_room_manager_label"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tv_room_manager_nickname"
                style="@style/TextLargeMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="@{vm.uiState.owner.nickname}"
                app:layout_constraintBottom_toBottomOf="@id/iv_room_manager"
                app:layout_constraintStart_toEndOf="@id/iv_room_manager"
                app:layout_constraintTop_toTopOf="@id/iv_room_manager"
                tools:text="버스를 놓친 사자" />

            <TextView
                style="@style/TextLargeMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:text="(나)"
                android:visibility="@{vm.uiState.owner.me ? View.VISIBLE : View.GONE}"
                android:textColor="@color/mx_gray500"
                app:layout_constraintBottom_toBottomOf="@id/tv_room_manager_nickname"
                app:layout_constraintStart_toEndOf="@id/tv_room_manager_nickname"
                app:layout_constraintTop_toTopOf="@id/tv_room_manager_nickname" />

            <TextView
                android:id="@+id/tv_temperature"
                style="@style/TextLargeRegular"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textColor="@color/mx_gray500"
                android:text="@{String.valueOf(vm.uiState.owner.portionCharge)}"
                app:layout_constraintBottom_toBottomOf="@id/iv_room_manager"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/iv_room_manager"
                tools:text="8,900" />

            <TextView
                android:id="@+id/tv_participant_label"
                style="@style/TextRegularSemibold"
                android:textColor="@color/mx_gray700"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="참여멤버"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iv_room_manager" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_participants"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_participant_label"
                app:layout_constraintEnd_toEndOf="parent"
                list="@{vm.uiState.participants}"
                tools:listitem="@layout/item_participant" />


            <View
                android:id="@+id/iv_dash_line2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/search_divider"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/rv_participants"/>

            <TextView
                android:id="@+id/total_price_label"
                style="@style/TextLargeMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="총액"
                android:textColor="@color/mx_gray500"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/iv_dash_line2" />

            <TextView
                android:id="@+id/total_price"
                style="@style/TextLargeMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:textColor="@color/mx_gray900"
                android:text="@{String.valueOf(vm.uiState.usageDetailUiData.totalCharge)}"
                app:layout_constraintBottom_toBottomOf="@id/total_price_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/total_price_label"
                tools:text="14,450" />

            <TextView
                android:id="@+id/matching_price_label"
                style="@style/TextLargeMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="최종 정산 금액"
                android:textColor="@color/mx_gray500"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/total_price_label" />

            <TextView
                android:id="@+id/matching_price"
                style="@style/TextLargeMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginRight="8dp"
                android:text="@{String.valueOf(vm.uiState.usageDetailUiData.portionCharge)}"
                android:textColor="@color/mx_gray900"
                app:layout_constraintBottom_toBottomOf="@id/matching_price_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/matching_price_label"
                tools:text="3,613" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tv_chat_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="채팅방은 2주가 지나면 읽을 수 없어요"
            android:textColor="#9C9C9C"
            style="@style/TextSmallMedium"
            app:layout_constraintTop_toBottomOf="@id/layout_usage"
            android:gravity="center"
            android:layout_marginTop="108dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_participate"
            style="@style/TextLargeSemibold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="채팅방 입장하기"
            android:paddingVertical="16dp"
            android:visibility="visible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_chat_label" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>