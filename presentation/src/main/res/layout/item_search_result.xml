<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="item"
            type="com.motax.modutaxi.presentation.ui.main.managetaxipot.model.UiSearchResultItem" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

        <View
            android:id="@+id/search_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/search_divider"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_place_name"
            style="@style/TextLargeMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:paddingLeft="8dp"
            android:paddingBottom="4dp"
            android:text="@{item.placeName}"
            android:textColor="@color/search_result_normal"
            app:keyword="@{item.keyword}"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/search_divider"
            app:searchResult="@{item.placeName}"
            tools:text="주안역" />

        <TextView
            android:id="@+id/tv_place_address"
            style="@style/TextRegularRegular"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingLeft="8dp"
            android:text="@{item.placeAddress}"
            android:textColor="@color/search_result_address_distance"
            app:layout_constraintEnd_toStartOf="@+id/tv_distance"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_place_name"
            tools:text="인천 미추홀구 주안로 41번길" />

        <TextView
            android:id="@+id/tv_distance"
            style="@style/TextRegularRegular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="@color/search_result_address_distance"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_place_name"
            tools:text="500m" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>