<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/rect_nofill_greystroke_12radius"
    xmlns:tools="http://schemas.android.com/tools"
    android:padding="16dp">

    <TextView
        android:id="@+id/tv_deadline_imminent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/rect_mint_fill_nostroke_4radius"
        android:text="마감임박"
        style="@style/TextSmallMedium"
        android:textColor="#40CEAC"
        android:paddingVertical="4dp"
        android:paddingHorizontal="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">
    </TextView>

    <TextView
        android:id="@+id/tv_student_verification"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/rect_red_fill_nostroke_4radius"
        android:text="학생인증"
        android:layout_marginLeft="8dp"
        style="@style/TextSmallMedium"
        android:textColor="#FF4949"
        android:paddingVertical="4dp"
        android:paddingHorizontal="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/tv_deadline_imminent">
    </TextView>

    <TextView
        android:id="@+id/tv_women_only"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/rect_grey_fill_nostroke_4radius"
        android:text="여자만"
        android:layout_marginLeft="8dp"
        style="@style/TextRegularMedium"
        android:textColor="#9C9C9C"
        android:paddingVertical="4dp"
        android:paddingHorizontal="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/tv_student_verification">
    </TextView>

    <TextView
        android:id="@+id/tv_quiet"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/rect_grey_fill_nostroke_4radius"
        android:text="조용히"
        android:layout_marginLeft="8dp"
        style="@style/TextRegularMedium"
        android:textColor="#9C9C9C"
        android:paddingVertical="4dp"
        android:paddingHorizontal="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/tv_women_only">
    </TextView>

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        tools:text="3분전 채팅"
        style="@style/TextSmallRegular"
        app:layout_constraintTop_toTopOf="@id/tv_women_only"
        app:layout_constraintEnd_toEndOf="parent"

        >
    </TextView>

    <ImageView
        android:id="@+id/iv_clock_fill"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:src="@drawable/btn_clock_fill"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/tv_women_only"
        app:layout_constraintStart_toStartOf="parent">
    </ImageView>

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="3월 25일 (월) 14:45 출발"
        style="@style/TextLargeSemibold"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@id/tv_women_only"
        app:layout_constraintStart_toEndOf="@id/iv_clock_fill">
    </TextView>








</androidx.constraintlayout.widget.ConstraintLayout>