<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="android.view.View" />

        <variable
            name="item"
            type="com.motax.modutaxi.presentation.ui.main.chat.model.UiChatMessage" />

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/iv_profile"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="6dp"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/ic_send_message" />

        <TextView
            android:id="@+id/tv_nick"
            style="@style/TextSmallMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@{item.sender}"
            android:textColor="@color/mx_gray700"
            app:layout_constraintBottom_toBottomOf="@id/iv_profile"
            app:layout_constraintStart_toEndOf="@id/iv_profile"
            app:layout_constraintTop_toTopOf="@id/iv_profile"
            tools:text="킹노아" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/rect_graychatfill_nostroke_chatradius"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/iv_profile">

            <TextView
                android:id="@+id/tv_message"
                style="@style/TextRegularRegular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="200dp"
                android:text="@{item.content}"
                android:textColor="@color/mx_gray800"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="우아" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_action"
                style="@style/TextSmallMedium"
                android:layout_width="120dp"
                android:layout_height="40dp"
                android:minHeight="1dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/rect_whitefill_sub500stroke_8radius"
                android:gravity="center"
                android:outlineProvider="none"
                android:textColor="@color/mx_sub500"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_message"
                tools:text="매칭완료" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tv_read_count"
            style="@style/TextCaptionRegular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            app:layout_constraintBottom_toTopOf="@id/tv_time"
            app:layout_constraintStart_toStartOf="@id/tv_time"
            tools:text="2" />

        <TextView
            android:id="@+id/tv_time"
            style="@style/TextCaptionRegular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:text="@{item.sentTime}"
            android:textColor="@color/mx_gray300"
            app:layout_constraintBottom_toBottomOf="@id/layout_message"
            app:layout_constraintStart_toEndOf="@id/layout_message"
            tools:text="14:15" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>