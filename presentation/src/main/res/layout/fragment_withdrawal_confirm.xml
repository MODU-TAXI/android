<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="vm"
            type="com.motax.modutaxi.presentation.ui.main.mypage.withdrawal.confirm.ConfirmViewModel" />
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="20dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layout_toolbar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:layout_marginTop="24dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_backward"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_header"
                style="@style/TextTitle3Semibold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="회원탈퇴"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />



        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/tv_nickname"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            style="@style/TextTitle3Semibold"
            android:text="모두의 택시를"
            android:textColor="@color/mx_gray900"
            android:layout_marginTop="36dp"
            android:layout_marginLeft="4dp"
            app:layout_constraintTop_toBottomOf="@id/layout_toolbar"
            app:layout_constraintStart_toStartOf="@id/layout_toolbar"/>

        <TextView
            android:id="@+id/tv_wait"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="이용해주셔서 정말 감사합니다."
            style="@style/TextTitle3Semibold"
            android:textColor="@color/mx_gray900"
            app:layout_constraintTop_toBottomOf="@id/tv_nickname"
            app:layout_constraintStart_toStartOf="@id/tv_nickname"/>


        <TextView
            android:id="@+id/tv_explain_first"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="모두의 택시는 즐거운 택시 동행 문화를 만들어가고 있어요\n지금까지 모두의 택시와 함께해주셔서 감사드려요"
            style="@style/TextSmallMedium"
            android:textColor="@color/mx_gray700"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_wait"
            app:layout_constraintStart_toStartOf="@id/tv_nickname"/>

        <TextView
            android:id="@+id/tv_explain_second"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text='@{"다음에 다시 만날 때 더 좋은 서비스가 되어" + vm.uiState.nickname + "을 맞이할게요"}'
            style="@style/TextSmallMedium"
            android:textColor="@color/mx_gray700"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tv_explain_first"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/tv_nickname"/>

        <TextView
            android:id="@+id/tv_explain_third"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text='@{vm.uiState.nickname + "님, 그간 모두의 택시와 함께해주셔서 감사해요"}'
            style="@style/TextSmallMedium"
            android:textColor="@color/mx_gray700"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_explain_second"
            app:layout_constraintStart_toStartOf="@id/tv_nickname"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_withdraw"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:background="@drawable/rect_sub500fill_nostroke_61radius"
            android:paddingVertical="10dp"
            android:paddingHorizontal="96dp"
            android:layout_marginLeft="34dp"
            android:layout_marginRight="34dp"
            android:text="탈퇴하기"
            android:onClick="@{() -> vm.deleteMember()}"
            style="@style/TextLargeSemibold"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_marginBottom="14dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>